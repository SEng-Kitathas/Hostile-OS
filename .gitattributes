# HOSTILE-OS canonical text policy
# Canonical Git text is LF so Linux/macOS/Windows clones see the same source bytes.
* text=auto eol=lf

# Binary / evidence formats must never undergo text normalization.
*.bin -text
*.img -text
*.elf -text
*.o -text
*.zip -text
*.tar -text
*.7z -text
*.gz -text
*.xz -text
*.pdf -text
*.png -text
*.jpg -text
*.jpeg -text
*.gif -text
*.ico -text
*.woff -text
*.woff2 -text
*.ttf -text

